# Backend Dockerfile for FastAPI development
# Optimized for Raspberry Pi and development workflow with Apple Silicon support

# Stage 1: Build SvelteKit frontend
FROM node:26-slim@sha256:14bf3eac4bf209d906d3c41256597d3ab1f926b2e93a79e9bdfe1efd32454239 AS frontend-builder

WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ .
RUN npm run build

# Stage 2: Python backend
FROM python:3.13-slim@sha256:a0779d7c12fc20be6ec6b4ddc901a4fd7657b8a6bc9def9d3fde89ed5efe0a3d

ARG VERSION=dev
LABEL org.opencontainers.image.version=$VERSION
ENV VERSION=$VERSION

# Install system dependencies for WiFi management and build tools
RUN apt-get update && apt-get install -y \
    wireless-tools \
    iw \
    network-manager \
    iproute2 \
    iputils-ping \
    curl \
    sudo \
    procps \
    net-tools \
    build-essential \
    gcc \
    g++ \
    make \
    pkg-config \
    libffi-dev \
    libssl-dev \
    swig \
    mpg123 \
    alsa-utils \
    pulseaudio-utils \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Create non-root user for development
RUN groupadd -r radio && useradd -r -g radio radio && \
    usermod -a -G audio radio && \
    mkdir -p /tmp/radio /var/log/radio /data /app/data && \
    chown -R radio:radio /tmp/radio /var/log/radio /data /app/data

# Create netdev group for NetworkManager access
RUN groupmod -g 104 netdev || groupadd -g 104 netdev && \
    usermod -a -G netdev radio

# Create gpio group matching Pi OS GID (986) for /dev/gpiochip0 access
RUN groupadd -g 986 gpio && usermod -a -G gpio radio

# Passwordless sudo restricted to what the backend actually invokes:
# nmcli (WiFi management, any args) and the exact host-mode marker commands.
# Unrestricted cp/mv/rm/chmod would be a trivial root escalation.
RUN { \
      echo "radio ALL=(ALL) NOPASSWD: /usr/bin/nmcli"; \
      echo "radio ALL=(ALL) NOPASSWD: /bin/rm -f /etc/raspiwifi/host_mode, /usr/bin/rm -f /etc/raspiwifi/host_mode"; \
      echo "radio ALL=(ALL) NOPASSWD: /bin/mkdir -p /etc/raspiwifi, /usr/bin/mkdir -p /etc/raspiwifi"; \
      echo "radio ALL=(ALL) NOPASSWD: /bin/touch /etc/raspiwifi/host_mode, /usr/bin/touch /etc/raspiwifi/host_mode"; \
    } > /etc/sudoers.d/radio && \
    chmod 0440 /etc/sudoers.d/radio && \
    visudo -c -f /etc/sudoers.d/radio

# Copy requirements first for better caching
COPY backend/requirements.lock backend/requirements-test.txt ./

# Install Python dependencies
ARG INSTALL_TEST_DEPS=false
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir --no-deps --require-hashes -r requirements.lock && \
    if [ "$INSTALL_TEST_DEPS" = "true" ]; then pip install --no-cache-dir -r requirements-test.txt; fi

# Build and install lg C library from source on arm64.
# liblgpio-dev is not in Debian trixie (only in Raspberry Pi OS repos).
# curl and build-essential/gcc/make are already in the image.
# Python's zipfile module extracts the zip without needing unzip.
# Upstream lg.zip is unversioned and mutates in place: the pinned SHA-256
# makes the build fail loudly on any upstream change (review it, then bump).
ARG LG_ZIP_SHA256=bb31c6031b632911a4cbbd1d47ea326f1249b9f9efe1504eca83d1e0ef0394af
RUN arch=$(dpkg --print-architecture) && \
    if [ "$arch" = "arm64" ]; then \
        curl -fsSL https://abyz.me.uk/lg/lg.zip -o /tmp/lg.zip && \
        echo "${LG_ZIP_SHA256}  /tmp/lg.zip" | sha256sum -c - && \
        python3 -c "import zipfile; zipfile.ZipFile('/tmp/lg.zip').extractall('/tmp/')" && \
        cd /tmp/lg && make && make install && \
        ldconfig && \
        cd / && rm -rf /tmp/lg /tmp/lg.zip && \
        pip install --no-cache-dir lgpio; \
    fi

# Copy entrypoint script
COPY docker/entrypoint-backend.sh /entrypoint.sh

# Copy built frontend static files
COPY --from=frontend-builder /frontend/build /app/static

# Copy application code
COPY backend/ .

# Make entrypoint executable
RUN chmod +x /entrypoint.sh

# Change ownership to radio user
RUN chown -R radio:radio /app /tmp/radio /var/log/radio

# Switch to non-root user
USER radio

# Expose the application port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Set environment variables
ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    API_PORT=8000

# Set entrypoint
ENTRYPOINT ["/entrypoint.sh"]

# Default command
CMD ["start"]
